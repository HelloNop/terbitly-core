msgid "plugins.generic.terbitlyCore.displayName"
msgstr "Terbitly Core"

msgid "plugins.generic.terbitlyCore.description"
msgstr "Sends new submissions and the editors' decisions to Terbitly, and shows invoices, receipts, the LOA and certificates on the submission page, as the journal chooses."

msgid "plugins.generic.terbitlyCore.settings.description"
msgstr "Copy the address and the token from this journal's OJS tab in Terbitly. Each journal has its own token."

msgid "plugins.generic.terbitlyCore.settings.appUrl"
msgstr "Terbitly address"

msgid "plugins.generic.terbitlyCore.settings.appUrlRequired"
msgstr "Enter the Terbitly address, for example https://ursci.org."

msgid "plugins.generic.terbitlyCore.settings.token"
msgstr "Journal token"

msgid "plugins.generic.terbitlyCore.settings.tokenRequired"
msgstr "Paste the token exactly as Terbitly shows it."

msgid "plugins.generic.terbitlyCore.referral.label"
msgstr "Referral code (optional)"

msgid "plugins.generic.terbitlyCore.referral.description"
msgstr "If someone referred you to this journal, enter their code. It does not affect the review or the fees."

msgid "plugins.generic.terbitlyCore.loa"
msgstr "Letter of acceptance"

msgid "plugins.generic.terbitlyCore.certificate"
msgstr "Certificate"

msgid "plugins.generic.terbitlyCore.certificateWaiting"
msgstr "Waiting for the article to be published."

msgid "plugins.generic.terbitlyCore.download"
msgstr "Download PDF"

msgid "plugins.generic.terbitlyCore.invoices"
msgstr "Invoices"

msgid "plugins.generic.terbitlyCore.receipts"
msgstr "Receipts"

msgid "plugins.generic.terbitlyCore.pay"
msgstr "Pay"

msgid "plugins.generic.terbitlyCore.apcBlocked"
msgstr "The APC is not paid yet. This journal publishes once it is paid; the publisher records the payment in Terbitly."

msgid "plugins.generic.terbitlyCore.apcDue.title"
msgstr "The APC is not paid yet."

msgid "plugins.generic.terbitlyCore.apcDue.text"
msgstr "This journal may publish before payment, so publishing now puts the article online; certificates are sent once the APC is paid."
